# Copy to .env. scripts/dev.py reads literal KEY=value pairs; it never executes shell code.
# JAVA_HOME=/path/to/jdk-21
FRONTEND_PORT=4200
GATEWAY_SERVICE_PORT=8080
TOOLS_SERVICE_PORT=8082
SNIPPETS_SERVICE_PORT=8083
DB_PORT=55432
# DB_DATA_DIR=/absolute/path/to/existing/dev/postgres
# An explicit URL uses an external database without starting or stopping it.
# SNIPPETS_DB_URL=jdbc:postgresql://127.0.0.1:55432/devdock_snippets
SNIPPETS_DB_USER=devdock
SNIPPETS_DB_PASSWORD=
